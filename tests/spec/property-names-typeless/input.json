{
  "openapi": "3.1.0",
  "paths": {},
  "components": {
    "schemas": {
      "Listed": {
        "description": "Without type, propertyNames asks what it lists of objects, and says the value is one.",
        "propertyNames": { "enum": ["a", "b"] }
      },
      "Prefixed": {
        "description": "So does a pattern: the keys are its templates.",
        "propertyNames": { "pattern": "^x-" }
      },
      "Member": {
        "description": "A member's propertyNames leaves out a key the object around it names but it does not list.",
        "type": "object",
        "properties": { "a": { "type": "string" }, "b": { "type": "string" } },
        "allOf": [{ "propertyNames": { "enum": ["a"] } }]
      },
      "MemberPattern": {
        "description": "Or does not match.",
        "type": "object",
        "properties": { "x-a": { "type": "string" }, "b": { "type": "string" } },
        "allOf": [{ "propertyNames": { "pattern": "^x-" } }]
      },
      "RequiredOutside": {
        "description": "A key it leaves out that the object requires admits no object.",
        "type": "object",
        "properties": { "a": { "type": "string" }, "b": { "type": "string" } },
        "required": ["b"],
        "allOf": [{ "propertyNames": { "enum": ["a"] } }]
      },
      "Sibling": {
        "description": "So does a key another member names.",
        "allOf": [
          { "properties": { "b": { "type": "string" } } },
          { "propertyNames": { "enum": ["a"] } }
        ]
      },
      "BesideUnion": {
        "description": "And a key a oneOf member of the object names.",
        "allOf": [{ "propertyNames": { "enum": ["a"] } }],
        "oneOf": [
          { "properties": { "b": { "type": "string" } } },
          { "properties": { "c": { "type": "string" } } }
        ]
      },
      "OrNull": {
        "description": "null, which type admits, passes it.",
        "type": ["object", "null"],
        "anyOf": [{ "propertyNames": { "enum": ["a"] } }]
      },
      "OfMember": {
        "description": "The object's own propertyNames leaves out a key its members name but it does not list.",
        "type": "object",
        "propertyNames": { "enum": ["a"] },
        "allOf": [{ "properties": { "b": { "type": "string" } } }]
      },
      "InThen": {
        "description": "So does a key then names.",
        "type": "object",
        "propertyNames": { "enum": ["a"] },
        "if": { "required": ["a"] },
        "then": { "properties": { "b": { "type": "string" } } }
      },
      "InDependent": {
        "description": "And a key a dependent schema names.",
        "type": "object",
        "propertyNames": { "enum": ["a"] },
        "dependentSchemas": { "a": { "properties": { "b": { "type": "string" } } } }
      },
      "InNestedMember": {
        "description": "And a key a member of a member names.",
        "type": "object",
        "propertyNames": { "enum": ["a"] },
        "allOf": [{ "oneOf": [{ "properties": { "b": { "type": "string" } } }] }]
      },
      "Pair": {
        "type": "object",
        "properties": { "a": { "type": "string" }, "b": { "type": "string" } }
      },
      "OfTarget": {
        "description": "So does a key its $ref target names.",
        "$ref": "#/components/schemas/Pair",
        "propertyNames": { "enum": ["a"] }
      },
      "OwnProperty": {
        "description": "A property's schema is another value: the keys around it are not its own.",
        "type": "object",
        "properties": { "b": { "type": "string" } },
        "allOf": [{ "properties": { "x": { "propertyNames": { "enum": ["a"] } } } }]
      }
    }
  }
}
