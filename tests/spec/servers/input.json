{
  "openapi": "3.1.0",
  "servers": [{ "url": "https://api.example.com" }],
  "paths": {
    "/uploads": {
      "servers": [{ "url": "https://uploads.example.com" }, { "url": "https://uploads-eu.example.com" }],
      "post": {
        "operationId": "upload",
        "responses": { "204": { "description": "ok" } }
      },
      "put": {
        "servers": [{ "url": "https://files.example.com/" }],
        "responses": { "204": { "description": "ok" } }
      }
    },
    "/regional": {
      "get": {
        "servers": [
          { "url": "https://{region}.example.com", "variables": { "region": { "default": "us" } } },
          { "url": "https://{region}.example.com/{version}", "variables": { "region": { "enum": ["us", "eu"], "default": "us" }, "version": { "default": "v1" } } },
          { "url": "/local" },
          { "url": "../v2/{stage}", "variables": { "stage": { "enum": ["beta"], "default": "beta" } } },
          { "url": "https://x.example.com/`${a}`" }
        ],
        "responses": { "204": { "description": "ok" } }
      }
    },
    "/here": {
      "get": {
        "servers": [{ "url": "./" }],
        "responses": { "204": { "description": "ok" } }
      }
    },
    "/plain": {
      "get": {
        "servers": [],
        "responses": { "204": { "description": "ok" } }
      },
      "delete": {
        "responses": { "204": { "description": "ok" } }
      }
    },
    "/inherited": {
      "servers": [{ "url": "https://inherited.example.com" }],
      "get": {
        "description": "An empty servers leaves the path item's to apply.",
        "servers": [],
        "responses": { "204": { "description": "ok" } }
      }
    }
  },
  "webhooks": {
    "ping": {
      "post": {
        "servers": [{ "url": "https://ignored.example.com" }],
        "responses": { "204": { "description": "ok" } }
      }
    }
  }
}
