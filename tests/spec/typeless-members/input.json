{
  "openapi": "3.1.0",
  "paths": {},
  "components": {
    "schemas": {
      "Pages": {
        "description": "Members without type constrain only the objects; null, which type admits, passes them.",
        "type": ["object", "null"],
        "properties": { "build_type": { "type": "string" }, "source": { "type": "string" } },
        "anyOf": [{ "required": ["source"] }, { "required": ["build_type"] }]
      },
      "StringOrObject": {
        "description": "So do strings.",
        "type": ["string", "object"],
        "allOf": [{ "properties": { "a": { "type": "string" } } }]
      },
      "ArrayOrNull": {
        "description": "Array keywords constrain only the arrays.",
        "type": ["array", "null"],
        "items": { "type": "string" },
        "allOf": [{ "minItems": 1 }]
      },
      "TaggedOrNull": {
        "description": "So does contains.",
        "type": ["array", "null"],
        "items": { "type": "string" },
        "allOf": [{ "contains": {} }]
      },
      "TaggedOrPrefixed": {
        "description": "The strings that pass are those the member's string keywords admit.",
        "type": ["array", "string"],
        "allOf": [{ "contains": {}, "pattern": "^a" }]
      },
      "TaggedOrSmall": {
        "description": "So are the integers, by its bounds.",
        "type": ["array", "integer"],
        "allOf": [{ "contains": {}, "minimum": 1, "maximum": 2 }]
      },
      "KeyedOrEmpty": {
        "description": "Next to object keywords too.",
        "type": ["object", "string"],
        "oneOf": [{ "required": ["a"], "maxLength": 0 }, { "required": ["b"], "pattern": "^b$" }]
      },
      "NestedOrNull": {
        "description": "A member whose members too are without type constrains only the objects.",
        "type": ["object", "null"],
        "allOf": [{ "required": ["a"], "allOf": [{ "minProperties": 1 }] }]
      },
      "NestedOrEmpty": {
        "description": "The strings that pass are those its members' string keywords admit too.",
        "type": ["object", "string"],
        "allOf": [{ "required": ["a"], "allOf": [{ "maxLength": 0 }] }]
      },
      "EitherOrEmpty": {
        "description": "Those one of its anyOf members admits.",
        "type": ["object", "string"],
        "allOf": [{ "anyOf": [{ "required": ["a"], "maxLength": 0 }, { "required": ["b"], "pattern": "^b$" }] }]
      },
      "OneOrEmpty": {
        "description": "Those one of its oneOf members admits; null passes both, so neither.",
        "type": ["object", "string", "null"],
        "allOf": [{ "oneOf": [{ "required": ["a"], "maxLength": 0 }, { "required": ["b"], "pattern": "^b$" }] }]
      },
      "NestedTyped": {
        "description": "A type in a member's member constrains every value.",
        "type": ["object", "null"],
        "allOf": [{ "required": ["a"], "allOf": [{ "type": "object" }] }]
      },
      "NotString": {
        "description": "A not in the member rejects the strings it says.",
        "type": ["object", "string"],
        "allOf": [{ "required": ["a"], "not": { "type": "string" } }]
      },
      "NotKeyed": {
        "description": "not: { required } rejects null, which required admits.",
        "type": ["object", "null"],
        "allOf": [{ "required": ["b"], "not": { "required": ["a"] } }]
      },
      "NotListed": {
        "description": "not: { const } leaves out the string it lists.",
        "type": ["object", "string"],
        "allOf": [{ "required": ["k"], "pattern": "^(a|b)$", "not": { "const": "a" } }]
      },
      "NotEmpty": {
        "description": "Even the one string the member admits.",
        "type": ["object", "string"],
        "allOf": [{ "required": ["k"], "maxLength": 0, "not": { "const": "" } }]
      },
      "NotUnread": {
        "description": "A not TypeScript cannot say is ignored, with a warning, for the other kinds too.",
        "type": ["object", "null"],
        "allOf": [{ "required": ["a"], "not": { "minProperties": 3 } }]
      },
      "IfInMember": {
        "description": "So does the member's if / then / else: if admits every string, so then holds for it.",
        "type": ["object", "string"],
        "allOf": [{ "required": ["a"], "if": { "required": ["b"] }, "then": { "maxLength": 0 } }]
      },
      "IfElseInMember": {
        "description": "Every string has the keys if asks of objects only, so no else holds for it.",
        "type": ["object", "string"],
        "allOf": [{ "required": ["a"], "if": { "required": ["b", "c"] }, "else": { "maxLength": 0 } }]
      },
      "Keys": { "minProperties": 1 },
      "Keyed": { "required": ["a"] },
      "RefInMember": {
        "description": "A $ref in the member is read as the schema it reaches.",
        "type": ["object", "null"],
        "allOf": [{ "required": ["a"], "allOf": [{ "$ref": "#/components/schemas/Keys" }] }]
      },
      "RefMember": {
        "description": "So is a $ref member.",
        "type": ["object", "null"],
        "allOf": [{ "$ref": "#/components/schemas/Keyed" }]
      },
      "RefBeside": {
        "description": "And a $ref next to type, whose target applies as a member does.",
        "type": ["object", "null"],
        "$ref": "#/components/schemas/Keyed"
      },
      "RefTyped": {
        "description": "A $ref to a schema with a type constrains every value.",
        "type": ["object", "null"],
        "allOf": [{ "$ref": "#/components/schemas/Cat" }]
      },
      "TrueInMember": {
        "description": "true admits every value.",
        "type": ["object", "null"],
        "allOf": [{ "required": ["a"], "allOf": [true] }]
      },
      "FalseInMember": {
        "description": "false admits none.",
        "type": ["object", "null"],
        "allOf": [{ "required": ["a"], "allOf": [false] }]
      },
      "PairOrNull": {
        "description": "dependentRequired, dependentSchemas and propertyNames constrain only the objects.",
        "type": ["object", "null"],
        "properties": { "a": { "type": "string" }, "b": { "type": "string" } },
        "allOf": [
          { "dependentRequired": { "a": ["b"] } },
          { "dependentSchemas": { "b": { "required": ["a"] } } },
          { "propertyNames": { "enum": ["a", "b"] } }
        ]
      },
      "Typed": {
        "description": "A member with a type of its own constrains every value.",
        "type": ["object", "null"],
        "allOf": [{ "type": "object", "required": ["a"] }]
      },
      "OnlyObject": {
        "description": "Without other types, nothing passes but objects.",
        "type": "object",
        "allOf": [{ "required": ["a"] }]
      },
      "StepOrObject": {
        "description": "The numbers pass the member as its keywords for numbers say.",
        "type": ["object", "number"],
        "allOf": [{ "required": ["a"], "minimum": 0, "maximum": 1, "multipleOf": 0.5 }]
      },
      "NotX": {
        "description": "The strings pass the member but the one its not lists, which TypeScript cannot leave out of string.",
        "type": ["object", "string"],
        "allOf": [{ "required": ["a"], "not": { "const": "x" } }]
      },
      "Prefixed": { "pattern": "^a" },
      "KeyedOrPrefixed": {
        "description": "Without type, the keywords of the schemas its members reach say what the value is.",
        "allOf": [{ "$ref": "#/components/schemas/Keyed" }, { "$ref": "#/components/schemas/Prefixed" }]
      },
      "KeyedOrSized": {
        "description": "The keywords next to a $ref say what the value is with its target's.",
        "$ref": "#/components/schemas/Keyed",
        "minItems": 1
      },
      "MeetTypes": {
        "description": "The kinds are those every member's type names.",
        "minItems": 1,
        "allOf": [{ "type": ["array", "string", "number"] }, { "type": ["array", "string"] }]
      },
      "IntegerWithinNumber": {
        "description": "integer is within number.",
        "minItems": 1,
        "allOf": [{ "type": ["array", "integer"] }, { "type": ["array", "number"] }]
      },
      "Cat": { "type": "object", "properties": { "kind": { "type": "string" } } },
      "ObjectOrString": {
        "description": "An object meets only the object members of a union.",
        "type": "object",
        "properties": { "a": { "type": "string" } },
        "oneOf": [{ "$ref": "#/components/schemas/Cat" }, { "type": "string" }]
      }
    }
  }
}
