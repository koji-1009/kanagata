{
  "openapi": "3.1.0",
  "paths": {},
  "components": {
    "schemas": {
      "Pages": {
        "description": "Members without type constrain only the objects; null, which type admits, passes them.",
        "type": ["object", "null"],
        "properties": { "build_type": { "type": "string" }, "source": { "type": "string" } },
        "anyOf": [{ "required": ["source"] }, { "required": ["build_type"] }]
      },
      "StringOrObject": {
        "description": "So do strings.",
        "type": ["string", "object"],
        "allOf": [{ "properties": { "a": { "type": "string" } } }]
      },
      "ArrayOrNull": {
        "description": "Array keywords constrain only the arrays.",
        "type": ["array", "null"],
        "items": { "type": "string" },
        "allOf": [{ "minItems": 1 }]
      },
      "Typed": {
        "description": "A member with a type of its own constrains every value.",
        "type": ["object", "null"],
        "allOf": [{ "type": "object", "required": ["a"] }]
      },
      "OnlyObject": {
        "description": "Without other types, nothing passes but objects.",
        "type": "object",
        "allOf": [{ "required": ["a"] }]
      },
      "Cat": { "type": "object", "properties": { "kind": { "type": "string" } } },
      "ObjectOrString": {
        "description": "An object meets only the object members of a union.",
        "type": "object",
        "properties": { "a": { "type": "string" } },
        "oneOf": [{ "$ref": "#/components/schemas/Cat" }, { "type": "string" }]
      }
    }
  }
}
