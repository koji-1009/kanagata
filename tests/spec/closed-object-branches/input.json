{
  "openapi": "3.1.0",
  "paths": {},
  "components": {
    "schemas": {
      "InThen": {
        "description": "additionalProperties sees only the properties next to it, so a closed object admits no key then names.",
        "type": "object",
        "properties": { "a": { "type": "string" } },
        "additionalProperties": false,
        "if": { "required": ["a"] },
        "then": { "properties": { "b": { "type": "string" } } }
      },
      "InElse": {
        "description": "Nor one else names.",
        "type": "object",
        "properties": { "a": { "type": "string" } },
        "additionalProperties": false,
        "if": { "required": ["a"] },
        "else": { "properties": { "c": { "type": "string" } } }
      },
      "InDependent": {
        "description": "Nor one a dependent schema names.",
        "type": "object",
        "properties": { "a": { "type": "string" } },
        "additionalProperties": false,
        "dependentSchemas": { "a": { "properties": { "b": { "type": "string" } } } }
      },
      "InNestedMember": {
        "description": "Nor one a member of a member names.",
        "type": "object",
        "properties": { "a": { "type": "string" } },
        "additionalProperties": false,
        "allOf": [{ "oneOf": [{ "properties": { "b": { "type": "string" } } }] }]
      },
      "AmongMembers": {
        "description": "A closed oneOf member admits no key another member names, in an allOf member of it too.",
        "oneOf": [
          { "type": "object", "properties": { "a": { "type": "string" } }, "additionalProperties": false },
          { "type": "object", "allOf": [{ "properties": { "b": { "type": "string" } }, "required": ["b"] }] }
        ]
      },
      "Base": { "type": "object" },
      "ClosedIntersection": {
        "description": "A closed member that is an intersection keeps the keys it declares.",
        "oneOf": [
          { "allOf": [{ "$ref": "#/components/schemas/Base" }], "properties": { "a": { "type": "string" } }, "additionalProperties": false },
          { "type": "object", "properties": { "a": { "type": "string" }, "b": { "type": "string" } } }
        ]
      }
    }
  }
}
