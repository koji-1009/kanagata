{
  "openapi": "3.1.0",
  "paths": {},
  "components": {
    "schemas": {
      "ThenRequired": {
        "description": "then holds where it evaluates a property; where it evaluates none, its required is not read.",
        "type": "object",
        "properties": { "kind": { "type": "string" } },
        "if": { "properties": { "kind": { "const": "a" } } },
        "then": { "required": ["y"], "properties": { "x": { "type": "string" }, "y": { "type": "string" } } },
        "unevaluatedProperties": false
      },
      "InMember": {
        "description": "So for an if in a member the unevaluatedProperties around it reads.",
        "type": "object",
        "allOf": [
          {
            "properties": { "kind": { "type": "string" } },
            "if": { "properties": { "kind": { "const": "a" } } },
            "then": { "properties": { "x": { "type": "string" } } }
          }
        ],
        "unevaluatedProperties": false
      },
      "InDependent": {
        "description": "So in a dependent schema.",
        "type": "object",
        "properties": { "card": { "type": "string" }, "country": { "type": "string" } },
        "dependentSchemas": {
          "card": { "if": { "properties": { "country": { "const": "US" } } }, "then": { "properties": { "zip": { "type": "string" } } } }
        },
        "unevaluatedProperties": false
      },
      "ThenEvaluatesNothing": {
        "description": "A then that evaluates nothing is not read: it is ignored.",
        "type": "object",
        "properties": { "kind": { "type": "string" }, "x": { "type": "string" } },
        "if": { "properties": { "kind": { "const": "a" } } },
        "then": { "required": ["x"] },
        "unevaluatedProperties": false
      },
      "NotRead": {
        "description": "Without unevaluatedProperties, then is not read.",
        "type": "object",
        "properties": { "kind": { "type": "string" } },
        "if": { "properties": { "kind": { "const": "a" } } },
        "then": { "properties": { "x": { "type": "string" } } }
      },
      "ThenPatterns": {
        "description": "A then that evaluates by its patterns is read.",
        "type": "object",
        "properties": { "kind": { "type": "string" } },
        "if": { "properties": { "kind": { "const": "a" } } },
        "then": { "patternProperties": { "^x-": { "type": "string" } } },
        "unevaluatedProperties": false
      },
      "ThenMembers": {
        "description": "So is one whose members evaluate.",
        "type": "object",
        "properties": { "kind": { "type": "string" } },
        "if": { "properties": { "kind": { "const": "a" } } },
        "then": { "oneOf": [{ "properties": { "x": { "type": "string" } } }] },
        "unevaluatedProperties": false
      },
      "ThenPrefix": {
        "description": "And one that evaluates items, by prefixItems.",
        "type": "array",
        "if": { "contains": { "type": "string" } },
        "then": { "prefixItems": [{ "type": "string" }] },
        "unevaluatedItems": false
      },
      "ThenContains": {
        "description": "Or by contains.",
        "type": "array",
        "if": { "contains": { "type": "string" } },
        "then": { "contains": { "type": "number" } },
        "unevaluatedItems": false
      }
    }
  }
}
