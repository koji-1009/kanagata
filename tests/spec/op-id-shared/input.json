{
  "openapi": "3.1.0",
  "paths": {
    "/health": { "$ref": "#/components/pathItems/Health" },
    "/v2/health": { "$ref": "#/components/pathItems/Health" },
    "/pets": { "$ref": "#/components/pathItems/Pets" }
  },
  "webhooks": {
