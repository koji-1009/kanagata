{
  "openapi": "3.1.0",
  "paths": {},
  "components": {
    "schemas": {
      "OneNamed": {
        "description": "A schema that names no arrays is not converted for the array it meets: its warning comes where it is.",
        "allOf": [{ "$ref": "#/components/schemas/Named" }, { "maxItems": 1 }]
      },
      "OneRetyped": {
        "description": "A $ref beside type: array is an array, read where it is met (its warning comes first), but its type is an intersection with the target's, which leaves no array type to put beside it.",
        "allOf": [{ "$ref": "#/components/schemas/Retyped" }, { "maxItems": 1 }]
      },
      "OneRetypedOrNull": {
        "description": "Nor among the members of a union.",
        "allOf": [{ "$ref": "#/components/schemas/RetypedOrNull" }, { "maxItems": 1 }]
      },
      "RetypedOrNull": { "anyOf": [{ "$ref": "#/components/schemas/Retyped" }, { "type": "null" }] },
      "Counts": { "type": "array", "items": { "type": "string" }, "contains": { "const": "a" } },
      "Named": { "type": ["object", "null"], "propertyNames": { "minLength": 2 } },
      "Base": { "description": "Any value." },
      "Retyped": {
        "$ref": "#/components/schemas/Base",
        "type": "array",
        "items": { "type": "string" },
        "contains": { "const": "a" }
      }
    }
  }
}
