{
  "openapi": "3.0.3",
  "paths": {
    "/holders": {
      "post": {
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Holder" } } } },
        "responses": { "204": { "description": "Holder is sent: its write view leaves out stamp, not base or both." } }
      }
    },
    "/files": {
      "post": {
        "requestBody": { "content": { "*/*": { "schema": { "$ref": "#/components/schemas/Upload" } } } },
        "responses": { "204": { "description": "Upload is no bytes: format next to its $ref is ignored." } }
      }
    }
  },
  "components": {
    "schemas": {
      "Base": { "type": "object", "properties": { "id": { "type": "string" } } },
      "Ext": {
        "description": "In 3.0, keywords next to $ref are ignored.",
        "$ref": "#/components/schemas/Base",
        "required": ["id"],
        "properties": { "tag": { "type": "string" } }
      },
      "Holder": {
        "description": "readOnly next to $ref is ignored too: base is sent and returned.",
        "type": "object",
        "properties": {
          "base": { "$ref": "#/components/schemas/Base", "readOnly": true },
          "both": { "$ref": "#/components/schemas/Base", "allOf": [{ "readOnly": true }] },
          "old": { "$ref": "#/components/schemas/Base", "description": "description next to $ref is read; deprecated is not.", "deprecated": true },
          "stamp": { "type": "string", "readOnly": true }
        }
      },
      "Negated": { "description": "Without $ref, an ignored keyword is reported.", "not": { "const": "x" } },
      "Old": { "$ref": "#/components/schemas/Base", "deprecated": true },
      "Name": { "type": "string" },
      "Upload": { "$ref": "#/components/schemas/Name", "type": "string", "format": "binary" },
      "Closed": {
        "description": "Nor is required next to a $ref in a member: the closed object admits Base.",
        "type": "object",
        "properties": { "id": { "type": "string" } },
        "additionalProperties": false,
        "allOf": [{ "$ref": "#/components/schemas/Base", "required": ["other"] }]
      },
      "Tagged": { "type": "object", "properties": { "tag": { "type": "string" } } },
      "Either": {
        "description": "Nor is additionalProperties next to a $ref: no member is closed.",
        "oneOf": [
          { "$ref": "#/components/schemas/Base", "properties": { "id": { "type": "string" } }, "additionalProperties": false },
          { "$ref": "#/components/schemas/Tagged" }
        ]
      },
      "Anything": {},
      "NeedsA": { "required": ["a"] },
      "NeedsB": { "required": ["b"], "properties": { "b": { "$ref": "#/components/schemas/Anything", "type": "string" } } },
      "OneKey": {
        "description": "Both members only require keys, whatever is next to their $refs, so each lacks the other's.",
        "oneOf": [{ "$ref": "#/components/schemas/NeedsA", "minProperties": 1 }, { "$ref": "#/components/schemas/NeedsB" }]
      },
      "Keyed": { "required": ["id"] },
      "MaybeKeyed": {
        "description": "null passes a member that is a $ref to a schema without type, whatever type is next to it.",
        "type": "object",
        "nullable": true,
        "allOf": [{ "$ref": "#/components/schemas/Keyed", "type": "object" }]
      },
      "ClosedKeyed": {
        "description": "Nor does type next to it keep the arrays of a member that requires a key the closed object forbids.",
        "type": "object",
        "nullable": true,
        "additionalProperties": false,
        "allOf": [{ "$ref": "#/components/schemas/Keyed", "type": "array" }]
      },
      "Way": { "type": "object", "properties": { "method": { "enum": ["ship", "pickup"] } } },
      "Shipped": {
        "description": "properties next to a $ref in a member declare no values if reads.",
        "type": "object",
        "allOf": [{ "$ref": "#/components/schemas/Way", "properties": { "method": { "enum": ["ship"] } } }],
        "properties": { "address": { "type": "string" } },
        "if": { "properties": { "method": { "const": "ship" } } },
        "then": { "required": ["address"] }
      },
      "Delivery": {
        "description": "Nor does enum next to a $ref.",
        "type": "object",
        "properties": { "method": { "$ref": "#/components/schemas/Name", "enum": ["ship"] }, "address": { "type": "string" } },
        "allOf": [{ "properties": { "method": { "enum": ["ship", "pickup"] } } }],
        "if": { "properties": { "method": { "const": "ship" } } },
        "then": { "required": ["address"] }
      }
    }
  }
}
