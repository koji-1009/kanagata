{
  "openapi": "3.1.0",
  "paths": {},
  "components": {
    "schemas": {
      "Kind": { "enum": ["a", "b", "c"] },
      "ByKind": {
        "description": "if fails where the property has another of the values it is declared with.",
        "type": "object",
        "required": ["kind"],
        "properties": { "kind": { "enum": ["a", "b"] }, "x": { "type": "string" }, "y": { "type": "string" } },
        "if": { "properties": { "kind": { "const": "a" } } },
        "then": { "required": ["x"] },
        "else": { "required": ["y"] }
      },
      "ByKey": {
        "description": "if fails where a key it requires is absent; no else asks nothing then.",
        "type": "object",
        "properties": { "a": { "type": "string" }, "b": { "type": "string" } },
        "if": { "required": ["a"] },
        "then": { "required": ["b"] }
      },
      "ByKeyOrString": {
        "description": "Object keywords alone, dependentRequired among them, let the strings type names pass.",
        "type": ["object", "string"],
        "properties": { "a": { "type": "string" }, "b": { "type": "string" } },
        "if": { "required": ["a"] },
        "then": { "dependentRequired": { "a": ["b"] } }
      },
      "InAllOf": {
        "description": "Each member's if reads the values the schema declares, through a $ref too.",
        "type": "object",
        "properties": { "kind": { "$ref": "#/components/schemas/Kind" }, "x": { "type": "string" }, "y": { "type": "string" } },
        "required": ["kind"],
        "allOf": [
          { "if": { "properties": { "kind": { "enum": ["a", "b"] } }, "required": ["kind"] }, "then": { "required": ["x"] } },
          { "if": { "properties": { "kind": { "const": "c" } } }, "then": { "required": ["y"] }, "else": false }
        ]
      },
      "ByType": {
        "description": "if: { type } fails for the other kinds, and a property's type for its others.",
        "type": ["object", "string", "null"],
        "properties": { "n": { "type": ["number", "string"] } },
        "if": { "type": "string" },
        "then": { "const": "s" },
        "else": { "if": { "properties": { "n": { "type": "number" } } }, "then": { "properties": { "n": { "const": 1 } } } }
      },
      "Nothing": {
        "description": "if without then and else asks nothing.",
        "type": "object",
        "if": { "properties": { "a": { "pattern": "^x" } } }
      },
      "Open": {
        "description": "A value it cannot tell from the declared ones (any string) cannot be expressed.",
        "type": "object",
        "properties": { "kind": { "type": "string" } },
        "if": { "properties": { "kind": { "const": "a" } } },
        "then": { "required": ["x"] }
      }
    }
  }
}
