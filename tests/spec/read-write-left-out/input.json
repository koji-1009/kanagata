{
  "openapi": "3.1.0",
  "paths": {
    "/things": {
      "post": {
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Holder" } } }
        },
        "responses": { "204": { "description": "done" } }
      }
    }
  },
  "components": {
    "schemas": {
      "Holder": {
        "type": "object",
        "properties": {
          "thing": { "$ref": "#/components/schemas/Thing" },
          "sibling": { "$ref": "#/components/schemas/ViaRefSibling" },
          "member": { "$ref": "#/components/schemas/MemberSiblings" },
          "either": { "$ref": "#/components/schemas/OneOfRequired" },
          "other": { "$ref": "#/components/schemas/Other" }
        }
      },
      "Base": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string" }, "name": { "type": "string" } } },
      "Thing": {
        "description": "A property another member leaves out is out of a referenced member too, which is then written out.",
        "allOf": [{ "$ref": "#/components/schemas/Base" }, { "properties": { "id": { "readOnly": true } } }]
      },
      "User": { "type": "object", "properties": { "id": { "type": "string", "readOnly": true }, "name": { "type": "string" } } },
      "ViaRefSibling": {
        "description": "required next to $ref does not bring back what the target leaves out.",
        "$ref": "#/components/schemas/User",
        "required": ["id", "name"]
      },
      "Named": { "type": "object", "properties": { "name": { "type": "string" } } },
      "MemberSiblings": {
        "description": "Nor what a member leaves out next to its $ref.",
        "allOf": [{ "$ref": "#/components/schemas/Named", "properties": { "id": { "type": "string", "readOnly": true } } }],
        "required": ["id", "name"]
      },
      "Other": {
        "description": "A referenced member without the key stays a reference.",
        "allOf": [{ "$ref": "#/components/schemas/Named" }, { "properties": { "id": { "type": "string", "readOnly": true } } }]
      },
      "OneOfRequired": {
        "description": "Nor a oneOf member's required.",
        "type": "object",
        "properties": { "id": { "type": "string", "readOnly": true }, "name": { "type": "string" } },
        "anyOf": [{ "required": ["id"] }, { "required": ["name"] }]
      }
    }
  }
}
