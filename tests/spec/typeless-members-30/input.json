{
  "openapi": "3.0.3",
  "paths": {},
  "components": {
    "schemas": {
      "Pages": {
        "description": "In 3.0, nullable adds null to type, and null passes members without type.",
        "type": "object",
        "nullable": true,
        "properties": { "build_type": { "type": "string" }, "source": { "type": "string" } },
        "anyOf": [{ "required": ["source"] }, { "required": ["build_type"] }]
      },
      "Keyed": { "required": ["a"] },
      "RefMember": {
        "description": "null passes a $ref to such a member; the keywords next to it are ignored.",
        "type": "object",
        "nullable": true,
        "allOf": [{ "$ref": "#/components/schemas/Keyed", "minItems": 1 }]
      },
      "Sized": { "minItems": 1 },
      "NotNullable": {
        "description": "Without nullable, no null passes.",
        "type": "string",
        "allOf": [{ "minItems": 1 }]
      },
      "SizedMember": {
        "description": "The strings pass a $ref to an array member; the keywords next to it, object ones among them, are ignored.",
        "type": "string",
        "allOf": [{ "$ref": "#/components/schemas/Sized", "required": ["a"] }]
      },
      "SizedBeside": {
        "description": "type next to a $ref is ignored too.",
        "$ref": "#/components/schemas/Sized",
        "type": "string"
      }
    }
  }
}
