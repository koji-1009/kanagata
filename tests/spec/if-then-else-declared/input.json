{
  "openapi": "3.1.0",
  "paths": {},
  "components": {
    "schemas": {
      "Toggle": {
        "description": "type: boolean lists true and false: if rejects true.",
        "type": "object",
        "properties": { "enabled": { "type": "boolean" }, "reason": { "type": "string" } },
        "if": { "properties": { "enabled": { "const": false } } },
        "then": { "required": ["reason"] }
      },
      "Subset": {
        "description": "An enum in if admits the values it lists and rejects the others.",
        "type": "object",
        "properties": { "kind": { "enum": ["a", "b", "c"] }, "x": { "type": "string" } },
        "if": { "properties": { "kind": { "enum": ["a", "b"] } } },
        "then": { "required": ["x"] }
      },
      "Shape": { "type": "object", "properties": { "kind": { "enum": ["circle", "square"] }, "radius": { "type": "number" } } },
      "Inherited": {
        "description": "The values come from an allOf member's $ref target alone.",
        "type": "object",
        "allOf": [{ "$ref": "#/components/schemas/Shape" }],
        "if": { "properties": { "kind": { "const": "circle" } } },
        "then": { "required": ["radius"] }
      },
      "Size": {
        "description": "type: string in if rejects null.",
        "type": "object",
        "properties": { "size": { "type": ["string", "null"], "enum": ["small", "large", null] }, "price": { "type": "number" } },
        "if": { "properties": { "size": { "type": "string" } } },
        "then": { "required": ["price"] }
      },
      "Version": {
        "description": "type: integer in if rejects the numbers that are not whole.",
        "type": "object",
        "properties": { "version": { "type": "number", "enum": [1, 1.5, 2] }, "notes": { "type": "string" } },
        "if": { "properties": { "version": { "type": "integer" } } },
        "then": { "required": ["notes"] }
      },
      "Undecided": {
        "description": "A keyword values are not read for decides nothing, though enum rejects some values first.",
        "type": "object",
        "properties": { "kind": { "enum": ["a", "b", "c"] }, "x": { "type": "string" } },
        "if": { "properties": { "kind": { "enum": ["a", "b"], "not": { "const": "b" } } } },
        "then": { "required": ["x"] }
      },
      "Narrowed": {
        "description": "The values are those every schema that declares the property lists.",
        "type": "object",
        "properties": { "kind": { "enum": ["a", "b", "c"] }, "x": { "type": "string" }, "y": { "type": "string" } },
        "allOf": [{ "properties": { "kind": { "enum": ["a", "b"] } } }],
        "if": { "properties": { "kind": { "const": "a" } } },
        "then": { "required": ["x"] },
        "else": { "required": ["y"] }
      },
      "Mode": { "type": "string" },
      "Beside": {
        "description": "An enum beside a $ref lists the values where its target lists none.",
        "type": "object",
        "properties": { "mode": { "$ref": "#/components/schemas/Mode", "enum": ["fast", "safe"] }, "limit": { "type": "integer" } },
        "if": { "properties": { "mode": { "const": "fast" } } },
        "then": { "required": ["limit"] }
      },
      "Level": {
        "description": "type: string in if rejects the numbers among the values.",
        "type": "object",
        "properties": { "level": { "enum": ["auto", 1, 2] }, "manual": { "type": "string" } },
        "if": { "properties": { "level": { "type": "string" } } },
        "else": { "required": ["manual"] }
      },
      "Amount": {
        "description": "Numbers, which type names beside objects, pass if and then, which have object keywords only.",
        "type": ["object", "number"],
        "properties": { "unit": { "enum": ["fixed", "percent"] }, "currency": { "type": "string" } },
        "if": { "properties": { "unit": { "const": "fixed" } } },
        "then": { "required": ["currency"] }
      }
    }
  }
}
