{
  "openapi": "3.0.3",
  "paths": {},
  "components": {
    "schemas": {
      "Name": { "type": "string", "nullable": true },
      "Tags": { "type": "array", "items": { "type": "string", "nullable": true }, "nullable": true },
      "Point": {
        "type": "object",
        "nullable": true,
        "required": ["x"],
        "properties": { "x": { "type": "number" }, "y": { "type": "number", "nullable": true } }
      },
      "Choice": { "type": "string", "enum": ["a", "b", null], "nullable": true },
      "Closed": { "description": "nullable adds null to the type; an enum without null still keeps it out (OAS 3.0.3).", "type": "string", "enum": ["a"], "nullable": true },
      "Untyped": { "description": "nullable without type takes no effect.", "enum": ["a"], "nullable": true },
      "Fixed": { "type": "string", "const": "a", "nullable": true },
      "NotNull": { "type": "string", "nullable": false },
      "MaybeNotNull": { "description": "3.0 ignores the keywords next to $ref, nullable among them.", "$ref": "#/components/schemas/NotNull", "nullable": true },
      "StillNotNull": { "description": "null must also pass allOf.", "type": "string", "allOf": [{ "$ref": "#/components/schemas/NotNull" }], "nullable": true },
      "MaybePoint": { "type": "object", "allOf": [{ "$ref": "#/components/schemas/Point" }], "nullable": true }
    }
  }
}
