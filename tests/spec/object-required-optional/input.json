{
  "openapi": "3.0.3",
  "paths": {},
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "required": ["id", "missing", "anything"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "address": {
            "type": "object",
            "required": ["city"],
            "properties": { "city": { "type": "string" }, "zip": { "type": "string" } }
          },
          "anything": { "description": "Any value, as when no property schema is given.", "nullable": true },
          "extra": {}
        }
      }
    }
  }
}
