{
  "openapi": "3.1.0",
  "paths": {},
  "components": {
    "schemas": {
      "Anything": true,
      "Targets": {
        "type": "object",
        "properties": {
          "repositories": { "type": "array", "items": { "type": "string" } },
          "lists": { "type": "array", "items": { "type": "string" } },
          "owners": { "type": "array", "items": { "type": "string" } }
        },
        "oneOf": [{ "required": ["repositories"] }, { "required": ["lists"] }, { "required": ["owners"] }]
      },
      "Forms": {
        "oneOf": [
          { "type": "object", "required": ["a"], "description": "by a", "x-note": true },
          {
            "properties": { "b": {}, "c": true, "d": { "$ref": "#/components/schemas/Anything", "description": "any" } },
            "required": ["b"]
          },
          { "$ref": "#/components/schemas/ByC", "description": "by c" }
        ]
      },
      "ByC": { "required": ["c"] },
      "Pair": {
        "oneOf": [{ "required": ["a", "b"] }, { "required": ["c"] }, { "required": ["a", "b", "c"] }]
      },
      "Mixed": {
        "oneOf": [
          { "required": ["a"] },
          { "required": ["c"] },
          { "properties": { "b": { "type": "number" } }, "required": ["b"] },
          { "properties": { "d": { "minLength": 1 } }, "required": ["d"] },
          { "properties": { "f": false }, "required": ["g"] },
          { "type": ["object", "null"], "required": ["e"] },
          { "$ref": "#/components/schemas/ByC", "required": ["h"] },
          false
        ]
      },
      "RefRequired": {
        "description": "Keywords next to a $ref apply too: it requires its target's keys and its own.",
        "oneOf": [{ "$ref": "#/components/schemas/ByC", "required": ["h"] }, { "required": ["a"] }]
      },
      "Alone": {
        "oneOf": [{ "required": [] }, { "required": ["a"] }]
      },
      "AnyObject": {
        "description": "type: object requires no key either: an object with a matches both.",
        "oneOf": [{ "type": "object" }, { "required": ["a"] }]
      },
      "Declared": {
        "description": "Nor do properties that admit any value.",
        "oneOf": [{ "properties": { "a": {} } }, { "required": ["b"] }]
      },
      "Restated": {
        "description": "A member property that restates the declaration of the property beside the oneOf, apart from annotations, asks nothing more.",
        "type": "object",
        "properties": { "a": { "type": "string" }, "b": { "type": "string" } },
        "oneOf": [{ "required": ["a"], "properties": { "a": { "type": "string", "format": "uuid" } } }, { "required": ["b"] }]
      },
      "RestatedType": {
        "type": "object",
        "properties": { "a": { "type": "string" }, "b": { "type": "string" } },
        "oneOf": [{ "required": ["a"], "properties": { "a": { "type": "string" } } }, { "required": ["b"] }]
      },
      "Narrower": {
        "description": "One that asks more is not counted: an object with a and b may match both.",
        "type": "object",
        "properties": { "a": { "type": "string" }, "b": { "type": "string" } },
        "oneOf": [{ "required": ["a"], "properties": { "a": { "type": "string", "minLength": 1 } } }, { "required": ["b"] }]
      },
      "Fewer": {
        "description": "Nor is one that leaves out keywords of the declaration: without properties, additionalProperties: false rejects x.",
        "type": "object",
        "properties": {
          "a": { "type": "object", "properties": { "x": {} }, "additionalProperties": false },
          "b": { "type": "string" }
        },
        "oneOf": [
          { "required": ["a"], "properties": { "a": { "type": "object", "additionalProperties": false } } },
          { "required": ["b"] }
        ]
      },
      "Either": {
        "anyOf": [{ "required": ["a"] }, { "required": ["b"] }]
      }
    }
  }
}
