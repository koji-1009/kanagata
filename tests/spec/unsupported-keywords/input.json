{
  "openapi": "3.1.0",
  "paths": {},
  "components": {
    "schemas": {
      "Cond": {
        "type": "object",
        "properties": { "kind": { "type": "string" } },
        "if": { "properties": { "kind": { "const": "a" } } },
        "then": { "required": ["a"] },
        "else": { "required": ["b"] },
        "dependentSchemas": { "kind": { "required": ["x"] } },
        "unevaluatedProperties": false
      },
      "Dyn": { "$dynamicRef": "#meta" },
      "Names": { "type": "object", "propertyNames": { "enum": ["a", "b"] } },
      "Contains": { "type": "array", "items": { "type": ["string", "number"] }, "contains": { "type": "string" } },
      "DepReq": {
        "type": "object",
        "properties": { "a": { "type": "string" }, "b": { "type": "string" } },
        "dependentRequired": { "a": ["b"] }
      }
    }
  }
}
