{
  "openapi": "3.1.0",
  "paths": {
    "/things": {
      "post": {
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Holder" } } }
        },
        "responses": { "204": { "description": "done" } }
      }
    }
  },
  "components": {
    "schemas": {
      "Holder": {
        "description": "id is readOnly through a $ref that resolves against its target's own $id: it is not sent.",
        "type": "object",
        "properties": {
          "id": { "$ref": "#/components/schemas/IdHolder" },
          "member": { "$ref": "#/components/schemas/MemberRequired" },
          "thing": { "$ref": "#/components/schemas/Thing" }
        },
        "required": ["id"]
      },
      "IdInner": { "$id": "https://example.com/id-inner", "type": "string", "readOnly": true },
      "IdHolder": { "$id": "https://example.com/id-holder", "$ref": "id-inner" },
      "UserInner": {
        "$id": "https://example.com/user-inner",
        "type": "object",
        "properties": { "id": { "type": "string", "readOnly": true }, "name": { "type": "string" } }
      },
      "UserHolder": { "$id": "https://example.com/user-holder", "$ref": "user-inner" },
      "MemberRequired": {
        "description": "required next to allOf does not bring back what the member's target leaves out through its own $ref.",
        "allOf": [{ "$ref": "#/components/schemas/UserHolder" }],
        "required": ["id", "name"]
      },
      "BaseInner": {
        "$id": "https://example.com/base-inner",
        "type": "object",
        "required": ["id", "name"],
        "properties": { "id": { "type": "string" }, "name": { "type": "string" } }
      },
      "BaseHolder": { "$id": "https://example.com/base-holder", "$ref": "base-inner" },
      "Thing": {
        "description": "A property another member leaves out is out of what the member's target reaches through its own $ref, which is then written out.",
        "allOf": [{ "$ref": "#/components/schemas/BaseHolder" }, { "properties": { "id": { "readOnly": true } } }]
      }
    }
  }
}
