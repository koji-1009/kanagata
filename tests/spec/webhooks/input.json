{
  "openapi": "3.1.0",
  "webhooks": {
    "x-hook": {
      "post": { "description": "webhooks is a map of names, not an object with extensions: x- is a name like any other.", "responses": { "204": { "description": "Received." } } }
    },
    "newPet": {
      "post": {
        "operationId": "onNewPet",
        "requestBody": {
          "description": "The API sends this, so it is the read view (readOnly kept, writeOnly left out).",
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Pet" } } }
        },
        "responses": {
          "200": {
            "description": "The receiver sends this, so it is the write view.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Pet" } } }
          }
        }
      }
    },
    "petGone": {
      "post": {
        "requestBody": {
          "description": "A form the API sends is its schema: the client does not receive it, so it is not the text a form response is.",
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": { "type": "object", "properties": { "id": { "type": "integer" } } }
            }
          }
        },
        "responses": { "204": { "description": "Received." } }
      }
    },
    "petUpdated": {
      "post": {
        "parameters": [
          { "name": "X-Pet", "in": "header", "description": "Parameters are the read view.", "schema": { "$ref": "#/components/schemas/Pet" } },
          {
            "name": "filter",
            "in": "query",
            "description": "A parameter defined by content is typed as a path's is: string for JSON.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Pet" } } }
          }
        ],
        "responses": {
          "200": {
            "description": "A form the receiver sends back is its schema too.",
            "headers": { "X-Echo": { "description": "Response headers are the write view.", "schema": { "$ref": "#/components/schemas/Pet" } } },
            "content": { "application/x-www-form-urlencoded": { "schema": { "$ref": "#/components/schemas/Pet" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pet": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "readOnly": true },
          "secret": { "type": "string", "writeOnly": true },
          "name": { "type": "string" }
        }
      }
    }
  }
}
