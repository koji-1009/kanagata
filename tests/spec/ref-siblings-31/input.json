{
  "openapi": "3.1.0",
  "paths": {
    "/holders": {
      "post": {
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Holder" } } } },
        "responses": { "204": { "description": "Holder is sent: its write view leaves out base." } }
      }
    }
  },
  "components": {
    "schemas": {
      "Base": { "type": "object", "properties": { "id": { "type": "string" } } },
      "Ext": {
        "description": "In 3.1, keywords next to $ref apply too.",
        "$ref": "#/components/schemas/Base",
        "required": ["id"],
        "properties": { "tag": { "type": "string" } }
      },
      "Described": { "$ref": "#/components/schemas/Base", "description": "Only an annotation next to $ref." },
      "Holder": {
        "description": "readOnly next to $ref applies: base is returned, not sent.",
        "type": "object",
        "properties": {
          "base": { "$ref": "#/components/schemas/Base", "readOnly": true },
          "old": { "$ref": "#/components/schemas/Base", "description": "description and deprecated next to $ref are read.", "deprecated": true },
          "name": { "type": "string" }
        }
      },
      "Negated": {
        "description": "An ignored keyword next to $ref is reported, as it would apply.",
        "$ref": "#/components/schemas/Base",
        "not": { "type": "string" }
      }
    }
  }
}
