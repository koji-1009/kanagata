{
  "openapi": "3.1.0",
  "paths": {},
  "components": {
    "schemas": {
      "RO": { "type": "object", "readOnly": true, "properties": { "x": { "type": "string" } } },
      "Holder": {
        "type": "object",
        "properties": {
          "owner": { "allOf": [{ "$ref": "#/components/schemas/RO" }], "description": "Wrapped to add a description." },
          "note": { "type": "string" }
        }
      },
      "Derived": {
        "description": "required next to allOf does not bring back a readOnly property when sending.",
        "allOf": [
          { "type": "object", "properties": { "id": { "type": "string", "readOnly": true }, "name": { "type": "string" } } }
        ],
        "required": ["id", "name"]
      },
      "Stamped": { "type": "object", "properties": { "stamp": { "type": "string", "readOnly": true } } },
      "Mixed": {
        "description": "Every allOf member counts, a $ref after an inline schema too.",
        "allOf": [
          { "type": "object", "properties": { "name": { "type": "string" } } },
          { "$ref": "#/components/schemas/Stamped" }
        ],
        "required": ["name", "stamp"]
      },
      "StampedBase": { "allOf": [{ "$ref": "#/components/schemas/Stamped" }] },
      "RequiredInMember": {
        "description": "required in another member does not bring back what a referenced member leaves out, through its own allOf too.",
        "allOf": [{ "$ref": "#/components/schemas/StampedBase" }, { "type": "object", "required": ["stamp"] }]
      },
      "RequiredInNestedMember": {
        "description": "Nor required in a member's allOf.",
        "allOf": [{ "$ref": "#/components/schemas/StampedBase" }, { "allOf": [{ "type": "object", "required": ["stamp"] }] }]
      }
    }
  }
}
