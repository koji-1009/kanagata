{
	"name": "kanagata",
	"version": "0.2.1",
	"description": "TypeScript types from OpenAPI 3.0 / 3.1 / 3.2 (JSON or YAML), and a typed fetch client",
	"keywords": [
		"openapi",
		"typescript",
		"codegen",
		"fetch",
		"api-client"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/koji-1009/kanagata.git"
	},
	"type": "module",
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": ">=24"
	},
	"bin": {
		"kanagata": "dist/bin.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		}
	},
	"sideEffects": false,
	"files": [
		"dist",
		"src/client.ts"
	],
	"dependencies": {
		"yaml": "^2.9.1"
	},
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
		"prepack": "pnpm build",
		"typecheck": "tsc -p tsconfig.json",
		"test": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:types",
		"lint": "biome ci .",
		"format": "biome check --write .",
		"test:unit": "node --test --test-isolation=none --experimental-test-coverage \"--test-coverage-include=src/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"tests/*.test.ts\" \"tests/unit/*.test.ts\" tests/ts/runtime.test.ts",
		"test:types": "tsc -p tests/ts",
		"test:real": "sh scripts/real-specs.sh"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@types/node": "^24.19.2",
		"typescript": "^7.0.2"
	}
}
